# ============================================================
# LicitacionesUV Backend - Variables de entorno (plantilla)
# ============================================================
# Instrucciones:
#   1. Copia este archivo como .env dentro de backend/
#      (los archivos .env reales NUNCA se suben al repositorio).
#   2. Reemplaza los valores de ejemplo por los de tu entorno.
#
# Formato general: CLAVE=valor (una variable por linea, sin comillas)
# Obligatoria: la aplicacion no funciona sin ella.
# Opcional: tiene un valor por defecto seguro.

# Puerto donde escucha el servidor HTTP.
# Nombre: PORT
# Obligatoria: no (por defecto 3000)
# Formato: numero entero entre 1 y 65535
PORT=3000

# Origen permitido para CORS (dev server de Vite).
# Nombre: CORS_ORIGIN
# Obligatoria: no (por defecto http://localhost:5173)
# Formato: URL absoluta del frontend
CORS_ORIGIN=http://localhost:5173

# ---- Base de datos PostgreSQL (docker-compose.yml en la raiz) ----

# Cadena de conexion a la base de desarrollo.
# Nombre: DATABASE_URL
# Obligatoria: no. Sin ella, la API usa los datos mock en memoria y
#   los scripts db:migrate y db:seed no se pueden ejecutar.
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# DATABASE_URL=postgresql://usuario:password@localhost:5432/licitaciones_db

# Cadena de conexion a la base de PRUEBAS (distinta de la de desarrollo).
# Nombre: DATABASE_URL_TEST
# Obligatoria: no. Sin ella, las pruebas de integracion con BD se omiten.
# Formato: igual que DATABASE_URL; el nombre de la base debe terminar en _test,
#   porque las pruebas borran y recrean su esquema.
# DATABASE_URL_TEST=postgresql://usuario:password@localhost:5432/licitaciones_test

# ---- Reservadas para las proximas entregas (no se usan aun) ----

# Secreto para firmar tokens de sesion (autenticacion).
# Nombre: JWT_SECRET
# Obligatoria: solo cuando exista autenticacion (Fase 2+)
# Formato: cadena aleatoria larga, nunca versionar el valor real
# JWT_SECRET=cambiar-por-un-secreto-real
