# ============================================================
# LicitacionesUV - Variables de entorno (plantilla de ejemplo)
# ============================================================
# Instrucciones:
#   1. Copia este archivo como .env (los archivos .env reales
#      NUNCA se suben al repositorio, estan en .gitignore).
#   2. Reemplaza los valores de ejemplo por los de tu entorno.
#
# Formato general: CLAVE=valor (una variable por linea, sin comillas)
# Obligatoria: la aplicacion no funciona sin ella.
# Opcional: tiene un valor por defecto seguro.

# ---- Frontend (Vite: solo se exponen al cliente las variables con prefijo VITE_) ----

# URL base de la API de licitaciones.
# Nombre: VITE_API_BASE_URL
# Obligatoria: no (el frontend aun lee el mock local; se usara al migrar a la API)
# Formato: URL absoluta, ej. http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# ---- PostgreSQL local con Docker Compose (docker-compose.yml) ----
# Las usa solo "docker compose up"; el backend se configura en backend/.env.
# Usa valores propios: nunca subas el .env real al repositorio.

# Usuario administrador del contenedor de PostgreSQL.
# Nombre: POSTGRES_USER
# Obligatoria: solo para docker compose
# Formato: texto sin espacios
# POSTGRES_USER=licitaciones

# Contrasena del usuario anterior.
# Nombre: POSTGRES_PASSWORD
# Obligatoria: solo para docker compose
# Formato: texto; elige una propia para tu equipo
# POSTGRES_PASSWORD=cambiar-por-una-contrasena-local

# Base de datos de desarrollo creada al iniciar el contenedor.
# Nombre: POSTGRES_DB
# Obligatoria: no (por defecto licitaciones_db)
# POSTGRES_DB=licitaciones_db

# Puerto del equipo donde se publica PostgreSQL.
# Nombre: POSTGRES_PORT
# Obligatoria: no (por defecto 5432)
# POSTGRES_PORT=5432
